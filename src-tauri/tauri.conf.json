{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OPPO Live Viewer",
  "version": "0.1.0",
  "identifier": "com.yezichao.oppo-live-viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OPPO Live Viewer",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: viewer: http://viewer.localhost; img-src 'self' viewer: http://viewer.localhost blob: data:; media-src 'self' viewer: http://viewer.localhost blob:; connect-src ipc: http://ipc.localhost http://viewer.localhost viewer: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
